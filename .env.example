# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models (tutor + practice use DEFAULT)
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_GRADER=claude-opus-5
ANTHROPIC_MODEL_FLASHCARDS=claude-haiku-4-5

# Corpus cache lifetime: "5m" or "1h".
# 1h costs 2x on a write (vs 1.25x) but breaks even at 3 requests/hour and
# avoids re-writing the ~70K-token corpus every time usage goes quiet.
CACHE_TTL=1h

# Serve practice problems + flashcards from the pre-generated bank
# (course_content/generated/, built by scripts/build_bank.py). Removes ~35% of
# live API traffic and two of the four prompt-cache prefixes. Falls back to
# live generation automatically if the bank has no entry.
USE_BANK=true

# Grader reasoning depth on Opus 5. medium returns the same verdict/score as
# high but runs ~30% faster; cost is dominated by the cached corpus read, so
# effort barely moves the bill.
GRADER_EFFORT=medium

# Past CAs add ~40% to the corpus, so they attach per-tool rather than globally.
# The grader needs them (only source for what earns full marks here); the tutor
# asks the next question, which the notes already support.
CA_FOR_GRADER=true
CA_FOR_TUTOR=false

# Cache pre-warming. The interval loop only re-warms models used within the
# last PREWARM_IDLE_AFTER_MIN minutes, so idle deployments cost nothing.
# Set PREWARM_INTERVAL_MIN=0 to disable it entirely.
PREWARM_ON_STARTUP=true
PREWARM_INTERVAL_MIN=50
PREWARM_IDLE_AFTER_MIN=90

# Access control (optional — leave blank to disable)
# When set, clients must send matching X-Passcode header
APP_PASSCODE=

# Rate limiting, counted per student (X-Client-Id from the frontend), NOT per
# IP — campus wifi NATs a whole cohort behind a few addresses, so IP-keyed
# limits make one student's usage eat everyone else's quota.
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=40

# Per-IP ceiling: abuse backstop only. Keep it well above what a full tutorial
# group behind one NAT address would generate, or it recreates the problem.
IP_RATE_LIMIT_PER_MIN=600
IP_RATE_LIMIT_PER_DAY=20000

# ---- Analytics ----
# Pseudonymous event log for usage reporting and education research.
# Stores metadata only — never student work, submissions, or feedback text.
ANALYTICS_ENABLED=true
ANALYTICS_DB=./data/analytics.db
# HMAC salt for student pseudonyms. MUST be set and stable for a real study:
# change it and the same student appears as a new person, breaking retention
# and improvement analysis. Leave unset locally for a throwaway per-boot salt.
ANALYTICS_SALT=
