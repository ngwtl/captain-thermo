# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models (tutor + practice use DEFAULT)
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_GRADER=claude-opus-5
ANTHROPIC_MODEL_FLASHCARDS=claude-haiku-4-5

# Corpus cache lifetime: "5m" or "1h".
# 1h costs 2x on a write (vs 1.25x) but breaks even at 3 requests/hour and
# avoids re-writing the ~70K-token corpus every time usage goes quiet.
CACHE_TTL=1h

# Cache pre-warming. The interval loop only re-warms models used within the
# last PREWARM_IDLE_AFTER_MIN minutes, so idle deployments cost nothing.
# Set PREWARM_INTERVAL_MIN=0 to disable it entirely.
PREWARM_ON_STARTUP=true
PREWARM_INTERVAL_MIN=50
PREWARM_IDLE_AFTER_MIN=90

# Access control (optional — leave blank to disable)
# When set, clients must send matching X-Passcode header
APP_PASSCODE=

# Rate limiting (per client IP)
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=300
